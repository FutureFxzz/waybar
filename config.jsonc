{
  "layer": "top",
  "position": "top",

  "margin-top": 0,
  "margin-bottom": 0,
  "margin-left": 0,
  "margin-right": 0,

  "spacing": 8,

  "modules-left": [
    "niri/workspaces",
    "niri/window",
    "custom/media"
  ],

  "modules-center": [
    "clock"
  ],

  "modules-right": [
    "custom/updates",
    "cpu",
    "memory",
    "temperature",
    "pulseaudio",
    "network",
    "battery",
    "power-profiles-daemon",
    "custom/swayidle",
    "tray"
  ],

  "niri/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "active": "",
      "default": ""
    }
  },

  "niri/window": {
    "format": "{}",
    "max-length": 60
  },

  "clock": {
      "format": "󰥔  {:%a %d %b  %H:%M}",
      "tooltip-format": "<big>{:%H:%M}</big>\n<tt>{:%A, %d %B %Y}</tt>",
  },

  "cpu": {
    "format": "  {usage}%"
  },

  "memory": {
    "format": "  {}%"
  },

  "temperature": {
    "critical-threshold": 80,
    "format": "  {temperatureC}°C"
  },


  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "󰖁  muted",
    "on-click": "pavucontrol",
    "format-icons": {
      "default": [
        "",
        "",
        ""
      ]
    }
  },

  "network": {
    "format-wifi": "  {signalStrength}%",
    "format-ethernet": "󰈀  ethernet",
    "format-disconnected": "󰖪  offline"
  },

  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon}  {capacity}%",
    "format-charging": "󰂄  {capacity}%",
    "format-plugged": "󰂄  {capacity}%",
    "format-icons": [
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ]
  },

  "power-profiles-daemon": {
    "format": "{icon}",
    "format-icons": {
      "performance": "󰓅",
      "balanced": "󰾅",
      "power-saver": "󰾆"
    }
  },

  "tray": {
    "spacing": 10
  }
}
